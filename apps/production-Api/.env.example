# PRODUCTION backend env. PLACEHOLDERS ONLY — never commit real values.
# Copy to .env, fill from the secrets vault, and set the same vars on the
# production hosting project (Vercel production env).
APP_ENV=production
NODE_ENV=production
PORT=3000
DATABASE_URL=PLACEHOLDER_PROD_DATABASE_URL
DATABASE_POOL_MODE=transaction
JWT_SECRET=PLACEHOLDER_PROD_JWT_SECRET_MIN_32_CHARS
# Pepper for stored OTP hashes (falls back to JWT_SECRET when unset; a
# separate 32+ char secret is recommended so rotation is independent).
OTP_SECRET=PLACEHOLDER_PROD_OTP_SECRET_MIN_32_CHARS
CORS_ORIGINS=PLACEHOLDER_PROD_CORS_ORIGINS
SUPABASE_URL=PLACEHOLDER_PROD_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_PROD_SUPABASE_SERVICE_ROLE_KEY
UPLOAD_DIR=./uploads
AI_PROVIDER_URL=PLACEHOLDER_PROD_AI_PROVIDER_URL
AI_PROVIDER_API_KEY=PLACEHOLDER_PROD_AI_PROVIDER_API_KEY
AI_MODEL=PLACEHOLDER_PROD_AI_MODEL
AI_VISION_URL=PLACEHOLDER_PROD_AI_VISION_URL
AI_VISION_MODEL=PLACEHOLDER_PROD_AI_VISION_MODEL
AI_VISION_API_KEY=PLACEHOLDER_PROD_AI_VISION_API_KEY
RAZORPAY_KEY_ID=PLACEHOLDER_PROD_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=PLACEHOLDER_PROD_RAZORPAY_KEY_SECRET
RAZORPAY_AI_PLAN_ID=PLACEHOLDER_PROD_RAZORPAY_AI_PLAN_ID
RAZORPAY_MEMBERSHIP_PLAN_ID=PLACEHOLDER_PROD_RAZORPAY_MEMBERSHIP_PLAN_ID
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_PROD_RAZORPAY_WEBHOOK_SECRET
GEOAPIFY_API_KEY=PLACEHOLDER_PROD_GEOAPIFY_API_KEY
FIREBASE_SERVICE_ACCOUNT_JSON=PLACEHOLDER_PROD_FIREBASE_SERVICE_ACCOUNT_JSON
PUSH_ENABLED=true
RESEND_API_KEY=PLACEHOLDER_PROD_RESEND_API_KEY
EMAIL_FROM=PLACEHOLDER_PROD_EMAIL_FROM
PUBLIC_WEB_URL=PLACEHOLDER_PROD_PUBLIC_WEB_URL
SMS_PROVIDER=PLACEHOLDER_PROD_SMS_PROVIDER
SMS_API_KEY=PLACEHOLDER_PROD_SMS_API_KEY
MSG91_AUTH_KEY=PLACEHOLDER_PROD_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=PLACEHOLDER_PROD_MSG91_TEMPLATE_ID
PREVIEW_EMAIL_OTP_ENABLED=false
CRON_SECRET=PLACEHOLDER_PROD_CRON_SECRET
SEED_ENGINEER_PASSWORD=PLACEHOLDER_PROD_SEED_PASSWORD
JOURNEY_TIMINGS=
NAHTREEK_E2E_SCHEMA=
