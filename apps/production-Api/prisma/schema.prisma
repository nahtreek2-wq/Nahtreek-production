generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ENGINEER
  SERVICE_PROVIDER
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum RequestStatus {
  DRAFT
  PENDING
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentReviewStatus {
  UPLOADED
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  RESOLVED
}

enum PaymentStatus {
  NOT_STARTED
  ORDER_CREATED
  PAID
  HELD
  RELEASE_PENDING
  RELEASED
  REFUND_PENDING
  REFUNDED
  FAILED
  DISPUTED
  COLLECTED_UNSETTLED
  SETTLED
}

enum PayoutAccountStatus {
  NOT_SUBMITTED
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  NONE
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageType {
  USER_TEXT
  AI_TEXT
  SYSTEM
  DOCUMENT
  IMAGE
  STRUCTURED_QUESTION
  PROJECT_PLAN
  SERVICE_RECOMMENDATION
  PROFESSIONAL_RECOMMENDATION
}

enum AiDocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model User {
  id              String        @id @default(uuid())
  displayName     String?
  email           String?       @unique
  phoneNumber     String        @unique
  passwordHash    String
  authVersion     Int           @default(0)
  status          AccountStatus @default(PENDING_VERIFICATION)
  isPhoneVerified Boolean       @default(false)
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  roles                         UserRole[]
  favorites                     Favorite[]
  clientProfile                 ClientProfile?
  professionalProfile           ProfessionalProfile?
  participants                  ConversationParticipant[]
  sentMessages                  Message[]
  notifications                 Notification[]
  notificationPreference        NotificationPreference?
  pushDevices                   PushDevice[]
  auditLogs                     AuditLog[]
  sessions                      Session[]
  aiConversations               AiConversation[]
  aiProjectPlans                AiProjectPlan[]
  aiDocuments                   AiDocument[]
  aiSubscription                AiSubscription?
  reviewedVerificationDocuments VerificationDocument[]    @relation("VerificationReviewer")
  supportTickets                SupportTicket[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model ClientProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  fullName        String
  avatarUrl       String?
  address         String?
  postalCode      String?
  termsAcceptedAt DateTime?
  termsVersion    String?
  city            String?
  state           String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  engineerRequests EngineerRequest[]
  serviceRequests  ServiceRequest[]
  reviewsWritten   Review[]
}

model ProfessionalProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  fullName           String             @default("")
  avatarUrl          String?
  coverUrl           String?
  title              String             @default("")
  bio                String?
  yearsOfExperience  Int                @default(0)
  onboardingStep     String             @default("IDENTITY")
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  averageRating      Float              @default(0.0)
  totalReviewsCount  Int                @default(0)
  isAvailable        Boolean            @default(true)
  serviceCategories  String[]           @default([])
  startingPrice      Float?
  baseCity           String             @default("")
  baseState          String             @default("")
  baseCityNorm       String             @default("")
  baseStateNorm      String             @default("")
  baseLatitude       Float?
  baseLongitude      Float?
  reviewCode         String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  engineerProfile       EngineerProfile?
  verificationDocuments VerificationDocument[]
  portfolioItems        PortfolioItem[]
  availabilitySlots     AvailabilitySlot[]
  serviceAreas          ServiceArea[]
  reviewsReceived       Review[]
  serviceRequests       ServiceRequest[]
  payoutAccount         PayoutAccount?
  presence              ProviderPresence?
  payments              Payment[]
  membership            Membership?
  memberPriority        Boolean                @default(false)
  CommissionSettlement  CommissionSettlement[]
  penalties             ProfessionalPenalty[]

  @@index([baseCityNorm])
  @@index([baseStateNorm])
}

model ServiceCategory {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  group       String
  description String
  prepare     String           @default("")
  iconName    String           @default("hammer-wrench")
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  requests    ServiceRequest[]
}

model ServiceRequest {
  id                    String                        @id @default(uuid())
  clientProfileId       String
  professionalProfileId String
  serviceCategoryId     String
  description           String
  locationAddress       String
  latitude              Float
  longitude             Float
  preferredStartDate    DateTime?
  status                RequestStatus                 @default(PENDING)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  client                ClientProfile                 @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  provider              ProfessionalProfile           @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  category              ServiceCategory               @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  statusHistory         ServiceRequestStatusHistory[]
  reviews               Review[]
  conversations         Conversation[]
  payment               Payment?
  journey               ServiceJourney?
  penalties             ProfessionalPenalty[]

  @@index([clientProfileId, createdAt])
  @@index([professionalProfileId, status])
}

model ServiceRequestStatusHistory {
  id               String         @id @default(uuid())
  serviceRequestId String
  fromStatus       RequestStatus?
  toStatus         RequestStatus
  changedByUserId  String
  reason           String?
  createdAt        DateTime       @default(now())
  request          ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, createdAt])
}

model ProviderPresence {
  professionalProfileId String              @id
  online                Boolean             @default(false)
  latitude              Float
  longitude             Float
  accuracy              Float
  observedAt            DateTime
  updatedAt             DateTime            @updatedAt
  radiusKm              Float               @default(10)
  profile               ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
}

model ServiceJourney {
  requestId            String         @id
  idempotencyKey       String         @unique
  payloadHash          String
  mode                 String
  stage                String         @default("PENDING")
  recipientName        String
  recipientPhone       String
  scheduledAt          DateTime?
  expiresAt            DateTime
  etaMinutes           Int?
  arrivalTarget        DateTime?
  quoteAmount          Float?
  quoteScope           String?
  quoteAccepted        Boolean        @default(false)
  collectionMode       String         @default("ONLINE")
  collectedAmountPaisa Int?
  collectedMethod      String?
  collectedAt          DateTime?
  startCode            String?
  codeAttempts         Int            @default(0)
  completionSummary    String?
  issue                String?
  revision             Int            @default(1)
  updatedAt            DateTime       @updatedAt
  request              ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([stage, expiresAt])
}

model EngineerProfile {
  consultationFee       Float?
  id                    String   @id @default(uuid())
  professionalProfileId String   @unique
  licenseNumber         String?  @unique
  qualificationDegree   String
  institution           String
  graduationYear        Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profile         ProfessionalProfile      @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specializations EngineerSpecialization[]
  requests        EngineerRequest[]
}

model AvailabilitySlot {
  id                    String   @id @default(uuid())
  professionalProfileId String
  startsAt              DateTime
  endsAt                DateTime
  isAvailable           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, startsAt])
}

model ServiceArea {
  id                    String   @id @default(uuid())
  professionalProfileId String
  name                  String
  city                  String?
  latitude              Float?
  longitude             Float?
  createdAt             DateTime @default(now())

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId])
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  engineers EngineerSpecialization[]
}

model EngineerSpecialization {
  engineerProfileId String
  specializationId  String

  engineer       EngineerProfile @relation(fields: [engineerProfileId], references: [id], onDelete: Cascade)
  specialization Specialization  @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([engineerProfileId, specializationId])
}

model EngineerRequest {
  id                 String        @id @default(uuid())
  clientProfileId    String
  engineerProfileId  String
  projectTitle       String
  projectDescription String
  propertyType       String
  projectSizeSqFt    Float?
  locationAddress    String
  latitude           Float
  longitude          Float
  preferredStartDate DateTime?
  budgetEstimate     Float?
  status             RequestStatus @default(PENDING)
  // Single-use completion proof: issued at ACCEPT, shown only to the client,
  // entered by the engineer to COMPLETE, nulled on use. Mirrors the service
  // journey startCode (plaintext for later reveal, attempt-capped).
  completionCode       String?
  completionCodeAttempts Int      @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client        ClientProfile          @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  engineer      EngineerProfile        @relation(fields: [engineerProfileId], references: [id], onDelete: Restrict)
  statusHistory RequestStatusHistory[]
  reviews       Review[]
  conversations Conversation[]
  payment       Payment?

  @@index([clientProfileId, status])
  @@index([engineerProfileId, status])
}

model RequestStatusHistory {
  id                String         @id @default(uuid())
  engineerRequestId String
  fromStatus        RequestStatus?
  toStatus          RequestStatus
  changedByUserId   String
  reason            String?
  // Engineer GPS captured at the transition (audit trail for visit claims).
  latitude          Float?
  longitude         Float?
  createdAt         DateTime       @default(now())

  request EngineerRequest @relation(fields: [engineerRequestId], references: [id], onDelete: Cascade)
}

model Review {
  id                    String   @id @default(uuid())
  clientProfileId       String
  professionalProfileId String
  engineerRequestId     String?  @unique
  serviceRequestId      String?  @unique
  rating                Int
  comment               String
  createdAt             DateTime @default(now())

  client          ClientProfile       @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  professional    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  engineerRequest EngineerRequest?    @relation(fields: [engineerRequestId], references: [id])
  serviceRequest  ServiceRequest?     @relation(fields: [serviceRequestId], references: [id])
}

model Conversation {
  id                String   @id @default(uuid())
  engineerRequestId String?
  serviceRequestId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  engineerRequest EngineerRequest?          @relation(fields: [engineerRequestId], references: [id])
  serviceRequest  ServiceRequest?           @relation(fields: [serviceRequestId], references: [id])
  participants    ConversationParticipant[]
  messages        Message[]

  @@index([engineerRequestId])
  @@index([serviceRequestId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderUserId   String
  content        String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model VerificationDocument {
  id                    String               @id @default(uuid())
  professionalProfileId String
  documentType          String
  documentUrl           String
  status                DocumentReviewStatus @default(UPLOADED)
  rejectionReason       String?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  uploadedAt            DateTime             @default(now())

  profile    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([professionalProfileId, documentType])
}

model PayoutAccount {
  id                    String              @id @default(uuid())
  professionalProfileId String              @unique
  provider              String
  providerAccountRef    String?             @unique
  accountHolderName     String
  bankName              String?
  accountLast4          String?
  status                PayoutAccountStatus @default(NOT_SUBMITTED)
  rejectionReason       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
}

model Payment {
  id                      String        @id @default(uuid())
  professionalProfileId   String
  engineerRequestId       String?       @unique
  serviceRequestId        String?       @unique
  provider                String        @default("RAZORPAY_ROUTE")
  providerOrderId         String?       @unique
  providerPaymentId       String?       @unique
  providerTransferId      String?       @unique
  amountPaisa             Int
  platformFeePaisa        Int
  professionalAmountPaisa Int
  currency                String        @default("INR")
  status                  PaymentStatus @default(NOT_STARTED)
  collectionMode          String        @default("ONLINE")
  settledAt               DateTime?
  idempotencyKey          String        @unique
  paidAt                  DateTime?
  releaseRequestedAt      DateTime?
  releasedAt              DateTime?
  refundedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  professional    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  engineerRequest EngineerRequest?    @relation(fields: [engineerRequestId], references: [id], onDelete: Restrict)
  serviceRequest  ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  events          PaymentEvent[]

  @@index([professionalProfileId, status, createdAt])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String
  providerEventId String   @unique
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

// At-home collection settlement: the provider collected cash/UPI directly
// and pays the accumulated platform commission back in one Razorpay order.
model CommissionSettlement {
  id                    String    @id @default(uuid())
  professionalProfileId String
  paymentIds            String[]
  amountPaisa           Int
  currency              String    @default("INR")
  status                String    @default("ORDER_CREATED")
  providerOrderId       String?   @unique
  providerPaymentId     String?   @unique
  idempotencyKey        String    @unique
  settledAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)

  @@index([professionalProfileId, status])
}

// Plus speed-SLA penalties: a late accept or late arrival on a Plus
// booking posts here and settles through the same dues flow as commission.
model ProfessionalPenalty {
  id                    String   @id @default(uuid())
  professionalProfileId String
  serviceRequestId      String
  amountPaisa           Int
  reason                String   @default("LATE_ARRIVAL")
  status                String   @default("PENDING")
  createdAt             DateTime @default(now())
  settledAt             DateTime?

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  serviceRequest      ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@unique([serviceRequestId, reason])
  @@index([professionalProfileId, status])
}

model Membership {
  id                     String           @id @default(uuid())
  professionalProfileId  String           @unique
  provider               String           @default("RAZORPAY")
  providerSubscriptionId String?          @unique
  status                 MembershipStatus @default(NONE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  lastChargeAt           DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  events  MembershipEvent[]
}

model MembershipEvent {
  id              String   @id @default(uuid())
  membershipId    String
  providerEventId String   @unique
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, createdAt])
}

model AiSubscription {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  provider               String           @default("RAZORPAY")
  providerSubscriptionId String?          @unique
  status                 MembershipStatus @default(NONE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  lastChargeAt           DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AiSubscriptionEvent[]
}

model AiSubscriptionEvent {
  id               String   @id @default(uuid())
  aiSubscriptionId String
  providerEventId  String   @unique
  eventType        String
  payload          Json
  createdAt        DateTime @default(now())

  subscription AiSubscription @relation(fields: [aiSubscriptionId], references: [id], onDelete: Cascade)

  @@index([aiSubscriptionId, createdAt])
}

model PortfolioItem {
  id                    String   @id @default(uuid())
  professionalProfileId String
  title                 String
  description           String?
  imageUrl              String
  createdAt             DateTime @default(now())

  profile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestUpdates Boolean   @default(true)
  messages       Boolean   @default(true)
  offers         Boolean   @default(false)
  lastTipAt      DateTime?
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  kind           String    @default("system")
  title          String
  body           String
  data           Json?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  pushState      String    @default("PENDING")
  pushAttempts   Int       @default(0)
  pushAfter      DateTime  @default(now())
  pushLeaseUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([pushState, pushAfter])
}

model PushDevice {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  sessionId String
  app       String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, app])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AiConversation {
  id          String               @id @default(uuid())
  userId      String
  title       String
  projectType String?
  city        String?
  status      AiConversationStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  plans     AiProjectPlan[]
  documents AiDocument[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  type           AiMessageType
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiProjectPlan {
  id                 String    @id @default(uuid())
  userId             String
  conversationId     String
  projectType        String
  title              String
  summary            String
  stages             Json
  recommendations    Json
  checklist          Json
  missingInformation Json
  safetyNote         String
  version            Int       @default(1)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([conversationId, version])
}

model AiDocument {
  id               String           @id @default(uuid())
  userId           String
  conversationId   String?
  fileName         String
  mimeType         String
  sizeBytes        Int
  status           AiDocumentStatus @default(UPLOADING)
  storageUrl       String?
  extractedSummary String?
  failureReason    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId, status])
}

// Typical market cost ranges quoted by NAHTREEK AI. The AI may only quote
// these stored ranges and must never invent prices. city 'ALL' is the
// fallback when no city-specific row exists.
model AiRateCard {
  id         String   @id @default(uuid())
  city       String
  serviceKey String
  label      String
  minPaisa   Int
  maxPaisa   Int
  unit       String
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([city, serviceKey])
  @@index([city])
}

model Favorite {
  id             String   @id @default(uuid())
  userId         String
  professionalId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
}

model Session {
  id                       String    @id @default(uuid())
  userId                   String
  refreshTokenHash         String
  previousRefreshTokenHash String?
  previousRotatedAt        DateTime?
  authVersion              Int       @default(0)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevices PushDevice[]

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitWindow {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model OtpChallenge {
  identifier      String   @id
  deliveryChannel String
  purpose         String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  requestedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SupportTicket {
  id           String              @id @default(uuid())
  userId       String
  subject      String
  message      String
  bookingRef   String?
  status       SupportTicketStatus @default(OPEN)
  adminReply   String?
  repliedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
